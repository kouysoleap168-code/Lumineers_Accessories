@model List<LumineersAccessories.Models.Product>
@{
    ViewData["Title"] = "Products";
}

<div class="admin-panel">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Products</h3>
        <a asp-action="Create" class="btn btn-primary-soft"><i class="bi bi-plus-lg"></i> Add Product</a>
    </div>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>ID</th><th>Name</th><th>Category</th><th>Price</th><th>Stock</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.ProductID</td>
                        <td>@p.ProductName</td>
                        <td>@p.Category?.CategoryName</td>
                        <td>$@p.Price.ToString("0.00")</td>
                        <td>@(p.Inventory?.StockLevel ?? 0)</td>
                        <td class="admin-actions">
                            <a asp-action="Details" asp-route-id="@p.ProductID" class="btn btn-sm btn-outline-soft">View</a>
                            <a asp-action="Edit" asp-route-id="@p.ProductID" class="btn btn-sm btn-outline-soft">Edit</a>
                            <form asp-action="Delete" asp-route-id="@p.ProductID" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-link text-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

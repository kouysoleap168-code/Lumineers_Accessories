@model LumineersAccessories.Models.Order
@{
    ViewData["Title"] = "Order #" + Model.OrderID;
    var statuses = new[] { "Pending", "Confirmed", "Processing", "Shipped", "Delivered", "Cancelled" };
}

<div class="admin-panel">
    <h3>Order #@Model.OrderID</h3>
    <p><strong>Customer:</strong> @Model.Customer?.FullName (@Model.Customer?.Email)</p>
    <p><strong>Date:</strong> @Model.OrderDate.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</p>
    <p><strong>Total:</strong> $@Model.TotalAmount.ToString("0.00")</p>

    <div class="update-status-form mt-3">
        <form asp-action="UpdateStatus" asp-route-id="@Model.OrderID" method="post" class="d-flex align-items-center gap-2">
            @Html.AntiForgeryToken()
            <label class="form-label mb-0">Update Status:</label>
            <select name="status" class="form-select form-select-sm w-auto">
                @foreach (var s in statuses)
                {
                    <option value="@s" selected="@(s == Model.Status)">@s</option>
                }
            </select>
            <button type="submit" class="btn btn-primary-soft btn-sm">Update</button>
        </form>
    </div>

    <hr />
    <h5>Items</h5>
    <table class="table table-sm">
        <thead><tr><th>Product</th><th>Qty</th><th>Price</th><th>Subtotal</th></tr></thead>
        <tbody>
            @foreach (var item in Model.OrderItems)
            {
                <tr>
                    <td>@item.Product?.ProductName</td>
                    <td>@item.Quantity</td>
                    <td>$@item.PricePerUnit.ToString("0.00")</td>
                    <td>$@((item.PricePerUnit * item.Quantity).ToString("0.00"))</td>
                </tr>
            }
        </tbody>
    </table>

    <h5>Shipping</h5>
    <p>@Model.ShippingDetail?.Address, @Model.ShippingDetail?.City, @Model.ShippingDetail?.PostalCode</p>
    @if (!string.IsNullOrEmpty(Model.ShippingDetail?.TrackingNumber))
    {
        <p><strong>Tracking:</strong> @Model.ShippingDetail.TrackingNumber</p>
    }

    <a asp-action="Index" class="btn btn-outline-soft mt-3">Back to Orders</a>
</div>

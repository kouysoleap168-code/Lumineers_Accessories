@model LumineersAccessories.Models.Category
@{
    ViewData["Title"] = "Edit Category";
}

<div class="admin-panel">
    <h3>Edit Category</h3>
    <form asp-action="Edit" asp-route-id="@Model.CategoryID" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CategoryID" />
        <div class="mb-3">
            <label asp-for="CategoryName" class="form-label"></label>
            <input asp-for="CategoryName" class="form-control" />
            <span asp-validation-for="CategoryName" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-primary-soft">Save Changes</button>
        <a asp-action="Index" class="btn btn-outline-soft">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model LumineersAccessories.Models.Category
@{
    ViewData["Title"] = "Add Category";
}

<div class="admin-panel">
    <h3>Add Category</h3>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="CategoryName" class="form-label"></label>
            <input asp-for="CategoryName" class="form-control" />
            <span asp-validation-for="CategoryName" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-primary-soft">Save</button>
        <a asp-action="Index" class="btn btn-outline-soft">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

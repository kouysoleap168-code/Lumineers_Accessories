@model LumineersAccessories.Models.ShippingDetail
@{
    ViewData["Title"] = "Update Tracking";
}

<div class="admin-panel">
    <h3>Update Tracking Number</h3>
    <p><strong>Order:</strong> #@Model.OrderID</p>
    <p><strong>Customer:</strong> @Model.Order?.Customer?.FullName</p>
    <p><strong>Address:</strong> @Model.Address, @Model.City, @Model.PostalCode</p>
    <hr />
    <form asp-action="Edit" asp-route-id="@Model.ShippingID" method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label">Tracking Number</label>
            <input type="text" name="trackingNumber" value="@Model.TrackingNumber" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary-soft">Save</button>
        <a asp-action="Index" class="btn btn-outline-soft">Cancel</a>
    </form>
</div>

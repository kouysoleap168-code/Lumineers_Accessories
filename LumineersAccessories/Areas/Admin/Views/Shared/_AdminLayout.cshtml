@{
    var customerName = Context.Session.GetString("CustomerName");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin - Lumineers Accessories</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="d-flex">
        <!-- Sidebar -->
        <aside class="admin-sidebar">
            <div class="admin-brand">Lumineers<span>Admin</span></div>
            <nav class="admin-nav">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a>
                <a asp-area="Admin" asp-controller="Products" asp-action="Index"><i class="bi bi-box-seam"></i> Products</a>
                <a asp-area="Admin" asp-controller="Categories" asp-action="Index"><i class="bi bi-tags"></i> Categories</a>
                <a asp-area="Admin" asp-controller="Orders" asp-action="Index"><i class="bi bi-receipt"></i> Orders</a>
                <a asp-area="Admin" asp-controller="Inventory" asp-action="Index"><i class="bi bi-clipboard-data"></i> Inventory</a>
                <a asp-area="Admin" asp-controller="Customers" asp-action="Index"><i class="bi bi-people"></i> Customers</a>
                <a asp-area="Admin" asp-controller="Shipping" asp-action="Index"><i class="bi bi-truck"></i> Shipping</a>
                <a asp-controller="Home" asp-action="Index"><i class="bi bi-shop"></i> View Store</a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="admin-nav-link"><i class="bi bi-box-arrow-right"></i> Logout</button>
                </form>
            </nav>
        </aside>

        <!-- Main -->
        <div class="admin-main">
            <header class="admin-topbar">
                <h1>@ViewData["Title"]</h1>
                <span class="admin-user">Signed in as @customerName</span>
            </header>
            <div class="admin-content">
                @if (TempData["Toast"] != null)
                {
                    <div class="alert alert-info-lumineers">@TempData["Toast"]</div>
                }
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

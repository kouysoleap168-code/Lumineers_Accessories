@model LumineersAccessories.Models.Customer
@{
    ViewData["Title"] = "My Profile";
    var recentOrders = ViewBag.RecentOrders as List<LumineersAccessories.Models.Order> ?? new List<LumineersAccessories.Models.Order>();
    var wishlistCount = (int)(ViewBag.WishlistCount ?? 0);
}

<section class="section">
    <div class="container">
        <div class="section-header text-center">
            <p class="section-eyebrow">Account</p>
            <h2 class="section-title">Welcome, @Model.FirstName</h2>
        </div>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="lumineers-card profile-card">
                    <div class="profile-avatar">@Model.FirstName.First()@Model.LastName.First()</div>
                    <h4>@Model.FullName</h4>
                    <p class="text-muted">@Model.Email</p>
                    @if (!string.IsNullOrEmpty(Model.Phone))
                    {
                        <p><i class="bi bi-telephone"></i> @Model.Phone</p>
                    }
                    <hr />
                    <div class="profile-stats">
                        <div class="stat">
                            <span class="stat-number">@recentOrders.Count</span>
                            <span class="stat-label">Recent Orders</span>
                        </div>
                        <div class="stat">
                            <span class="stat-number">@wishlistCount</span>
                            <span class="stat-label">Wishlist Items</span>
                        </div>
                    </div>
                    <a asp-controller="Wishlist" asp-action="Index" class="btn btn-outline-soft w-100 mt-3">View Wishlist</a>
                    <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-soft w-100 mt-2">View All Orders</a>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="lumineers-card">
                    <h4>Recent Orders</h4>
                    @if (!recentOrders.Any())
                    {
                        <p class="text-muted py-3">You have no recent orders.</p>
                    }
                    else
                    {
                        <table class="table table-sm align-middle">
                            <thead><tr><th>Order #</th><th>Date</th><th>Total</th><th>Status</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var order in recentOrders)
                                {
                                    <tr>
                                        <td>@order.OrderID</td>
                                        <td>@order.OrderDate.ToLocalTime().ToString("MMM dd, yyyy")</td>
                                        <td>$@order.TotalAmount.ToString("0.00")</td>
                                        <td><span class="badge bg-warning-soft">@order.Status</span></td>
                                        <td><a asp-controller="Orders" asp-action="Details" asp-route-id="@order.OrderID" class="btn btn-sm btn-outline-soft">View</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@{
    ViewData["Title"] = "About";
    var brandImage = "https://images.pexels.com/photos/7743155/pexels-photo-7743155.jpeg?auto=compress&cs=tinysrgb&h=650&w=940";
}

<section class="section about-hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <p class="section-eyebrow">Our Story</p>
                <h1 class="section-title">About Lumineers Accessories</h1>
                <p class="lead-text">Lumineers Accessories is an online accessories store focused on elegant, affordable, and beautiful accessories for everyday style.</p>
                <p class="body-text">We believe the right little detail — a soft bracelet, a delicate necklace, a simple ring — can change how an outfit, and a day, feels. Our pieces are designed to be worn often, layered freely, and loved for a long time.</p>
            </div>
            <div class="col-lg-6">
                <div class="about-image" style="background-image: url('@brandImage');"></div>
            </div>
        </div>
    </div>
</section>

<section class="section mission-section">
    <div class="container text-center">
        <p class="section-eyebrow">Our Mission</p>
        <h2 class="mission-quote">“To help everyone express their personal style through little details that shine.”</h2>
    </div>
</section>

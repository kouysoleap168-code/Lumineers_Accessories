@model List<CartItem>
@{
    ViewData["Title"] = "Shopping Cart";
    var subtotal = Model.Sum(c => c.Subtotal);
    var shipping = Model.Any() ? 4.99m : 0m;
    var total = subtotal + shipping;
}

<section class="section">
    <div class="container">
        <div class="section-header text-center">
            <p class="section-eyebrow">Your Selection</p>
            <h2 class="section-title">Shopping Cart</h2>
        </div>

        @if (!Model.Any())
        {
            <p class="text-center text-muted py-5">Your cart is empty. <a asp-controller="Products" asp-action="Index">Start shopping</a>.</p>
        }
        else
        {
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="lumineers-card">
                        <table class="table cart-table align-middle">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Price</th>
                                    <th>Quantity</th>
                                    <th>Subtotal</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="cart-product">
                                                <div class="cart-thumb" style="background-image: url('@item.ImageUrl');"></div>
                                                <span>@item.ProductName</span>
                                            </div>
                                        </td>
                                        <td>$@item.Price.ToString("0.00")</td>
                                        <td>
                                            <form asp-controller="Cart" asp-action="Update" method="post" class="d-flex align-items-center gap-1">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="productID" value="@item.ProductID" />
                                                <input type="number" name="quantity" value="@item.Quantity" min="1" max="@item.StockLevel" class="form-control form-control-sm cart-qty" />
                                                <button type="submit" class="btn btn-sm btn-outline-soft">Update</button>
                                            </form>
                                        </td>
                                        <td>$@item.Subtotal.ToString("0.00")</td>
                                        <td>
                                            <form asp-controller="Cart" asp-action="Remove" asp-route-id="@item.ProductID" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-link text-danger" title="Remove"><i class="bi bi-trash"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-soft mt-3">Continue Shopping</a>
                </div>
                <div class="col-lg-4">
                    <div class="lumineers-card cart-summary">
                        <h4>Order Summary</h4>
                        <div class="summary-row"><span>Subtotal</span><span>$@subtotal.ToString("0.00")</span></div>
                        <div class="summary-row"><span>Shipping</span><span>$@shipping.ToString("0.00")</span></div>
                        <hr />
                        <div class="summary-row total"><span>Total</span><span>$@total.ToString("0.00")</span></div>
                        <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary-soft w-100 mt-3">Proceed to Checkout</a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
